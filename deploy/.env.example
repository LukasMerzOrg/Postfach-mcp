# 32 random bytes, base64: docker run --rm ghcr.io/lukasmerzorg/postfach-mcp generate-key
POSTFACH_SECRET_KEY=
# Owner login for the OAuth consent page (claude.ai connector):
# printf '%s' 'a long password' | docker run -i --rm ghcr.io/lukasmerzorg/postfach-mcp hash-password
POSTFACH_OWNER_USERNAME=
# Docker Compose interpolates '$' in env files: write each $ of the hash as $$.
POSTFACH_OWNER_PASSWORD_HASH=
# Optional static token for non-OAuth clients: docker run --rm ghcr.io/lukasmerzorg/postfach-mcp generate-token
# POSTFACH_API_TOKEN=
# POSTFACH_API_TOKEN_SCOPES=mail.read mail.organize mail.draft
# Mailbox secrets referenced by password_env in postfach.yaml
POSTFACH_PRIVATE_PASSWORD=
