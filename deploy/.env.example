# 32 random bytes, base64: docker run --rm ghcr.io/lukasmerzorg/postfach-mcp generate-key
POSTFACH_SECRET_KEY=
# A long random token for the MCP client: docker run --rm ghcr.io/lukasmerzorg/postfach-mcp generate-token
POSTFACH_API_TOKEN=
POSTFACH_API_TOKEN_SCOPES=mail.read mail.organize mail.draft
# Mailbox secrets referenced by password_env in postfach.yaml
POSTFACH_PRIVATE_PASSWORD=
